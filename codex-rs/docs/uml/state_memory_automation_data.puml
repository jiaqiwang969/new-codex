@startuml state_memory_automation_data
title Key objects + join keys (thread/turn/call + memory link)

' High resolution output (primarily for PNG). SVG ignores DPI.
skinparam dpi 300

!pragma layout elk
!theme aws-orange
skinparam linetype ortho
skinparam shadowing false
skinparam defaultTextAlignment left
skinparam wrapWidth 220
skinparam nodesep 60
skinparam ranksep 80

top to bottom direction
hide empty members

class "rollout.jsonl\n(append-only)" as RolloutFile <<file>>
class "state.sqlite\n(projection + locks)" as StateDb <<database>>
class "memories/*/memory_summary.md" as MemorySummaryFile <<file>>

class ThreadId
class TurnId
class CallId

class "RolloutItem\n(protocol::RolloutItem)" as RolloutItem {
  +thread_id: ThreadId
  +turn_id: TurnId
  +item_type: ...
  +call_id: Option<CallId>
  +memory: Option<MemoryLink>
}

class "MemorySummary\n(from memory_summary.md)" as MemorySummary {
  +scope_kind: cwd|user|global
  +summary_sha256: String
  +scope_version: String
  +binding_key: String
}

class "MemoryLink\n(app-server v2 + protocol)" as MemoryLink {
  +scope_version: Option<String>
  +binding_key: Option<String>
}

class "HookPayload\n(hooks::types)" as HookPayload {
  +session_id: ThreadId
  +hook_event: HookEvent
  +hook_event.* memory_*: Option<String>
}

class "threads" as ThreadsTable
class "stage1_outputs" as Stage1OutputsTable
class "jobs/locks" as JobsTable

RolloutFile "1" o-- "*" RolloutItem : contains events
RolloutItem --> ThreadId
RolloutItem --> TurnId
RolloutItem --> CallId
RolloutItem --> MemoryLink : continuity metadata\n(optional)

MemorySummaryFile --> MemorySummary : materialized content
MemorySummary --> MemoryLink : projected fields
MemoryLink --> HookPayload : copied into\nhook events

StateDb "1" o-- "*" ThreadsTable
StateDb "1" o-- "*" Stage1OutputsTable
StateDb "1" o-- "*" JobsTable

ThreadsTable --> ThreadId
Stage1OutputsTable --> ThreadId : per thread
Stage1OutputsTable ..> RolloutFile : derived by scan
MemorySummaryFile ..> Stage1OutputsTable : stage2 uses\nraw memories

note right of RolloutFile
  Rollout is the source of truth.
  State DB is a projection/index and
  a coordination store (jobs/locks).
end note

note bottom of MemoryLink
  binding_key is the best join key to correlate:
  - tool calls / hook payloads
  - the active memory_summary.md version
end note

@enduml
