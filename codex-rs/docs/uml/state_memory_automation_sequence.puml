@startuml state_memory_automation_sequence
title Turn execution: state db + rollout + memory + hooks (via app-server v2)

' High resolution output (primarily for PNG). SVG ignores DPI.
skinparam dpi 300
skinparam maxMessageSize 300

!pragma teoz
!theme aws-orange
skinparam linetype ortho
skinparam shadowing false
skinparam defaultTextAlignment left
skinparam wrapWidth 220

actor AutomationClient as Client
participant "codex-app-server\n(JSON-RPC v2)" as AppServer
participant "codex-core\n(session engine)" as Core
database "rollout.jsonl\n(append-only)" as Rollout
database "state.sqlite\n(projection + locks)" as StateDb
collections "memories/*/memory_summary.md" as MemFS
participant "hooks runner\n(codex-hooks)" as Hooks
participant "hook target\n(cli adapter / webhook)" as HookTarget
participant "MCP server\n(npx ...)" as Mcp
participant "LLM provider\n(OpenAI/Gemini/...)" as LLM

Client -> AppServer : turn/start(threadId, input, modelOverride?)
AppServer -> Core : start_turn(...)

Core -> MemFS : select active memory\n(cwd > user > global)
MemFS --> Core : MemoryLink(scopeVersion, bindingKey)

Core -> LLM : /responses(input + tools + memory summary)
LLM --> Core : response + tool_call(s)

alt Local tool (shell / apply_patch / etc.)
  Core -> Core : execute tool
  Core -> Rollout : append tool_call + output
  Core -> Hooks : AfterToolUse(payload + memory link)
  Hooks -> HookTarget : exec/notify
else MCP tool
  Core -> Mcp : tool call (JSON-RPC)
  Mcp --> Core : result / error
  Core -> Rollout : append mcp_tool_call result
  Core -> Hooks : AfterMcpToolCall(payload + memory link)
  Hooks -> HookTarget : exec/notify
end

Core -> LLM : submit tool outputs
LLM --> Core : assistant message
Core -> Rollout : append assistant message
Core -> StateDb : upsert thread metadata\n(+ optional stage1 output)

AppServer --> Client : notifications\n(thread/item, turn/completed)

par Background memory pipeline (startup)
  Core -> Core : schedule memory startup task
  Core -> StateDb : claim jobs/locks
  Core -> Rollout : scan candidate rollouts
  Core -> LLM : stage1 extract / stage2 consolidate
  Core -> StateDb : persist stage1 outputs
  Core -> MemFS : write memory_summary.md
end

note over MemFS
  MemoryLink is copied into:
  - rollout items (mcp/collab tool calls)
  - hook payloads
  so cross-agent continuity can be correlated.
end note

@enduml
